# Copy to .env for local / Compose overrides (never commit .env).
# Image build does not embed these values.

SMART_ROUTER_HOST=0.0.0.0
SMART_ROUTER_PORT=18765

# Gateway Bearer token for /v1/* and /admin/* (change for anything beyond local stub demos)
SMART_ROUTER_API_KEY=mirevox-dev-key

# Paths — Compose overrides these to /app/... inside the container
SMART_ROUTER_CONFIG=./config/default.yaml
SMART_ROUTER_VAULT_PATH=./data/vault.json

# v0.1: catalogs + completions are always stubs. Setting this to false does NOT
# enable live provider calls (deferred H-06); keep true for clarity.
SMART_ROUTER_STUB_MODE=true

# Optional provider credentials — stored/verified in vault for v0.2 live adapters.
# In v0.1 they are NOT used for outbound inference or discovery probes.
# Prefer env here or vault volume — never bake into the Dockerfile.
# SMART_ROUTER_KEY_AZURE_FOUNDRY=
# SMART_ROUTER_KEY_AWS_BEDROCK=
# SMART_ROUTER_KEY_GOOGLE_VERTEX=
# SMART_ROUTER_KEY_LOCAL_OLLAMA=
# SMART_ROUTER_KEY_MCP_BRIDGE=
